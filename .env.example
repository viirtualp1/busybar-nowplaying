# --- BUSY Bar connection -----------------------------------------------------
# USB (default): nothing to set, the Bar answers on 10.0.4.20
# Wi-Fi: the Bar's IP plus the HTTP Access password from its web UI
# Cloud: https://api.busy.app plus a token
BUSY_ADDR=
BUSY_HTTP_PASSWORD=
BUSY_TOKEN=

# How hard this app fights other apps for the screen (0-100).
DRAW_PRIORITY=40

# --- Media source ------------------------------------------------------------
# auto (default) picks macos or windows by platform.
MEDIA_SOURCE=auto

# Only follow players whose bundle id / AUMID / name contains this. Empty means
# whatever the machine is playing. Examples: chrome, spotify, youtube
MEDIA_APP=

# --- Tempo -------------------------------------------------------------------
# How often the media backend is asked. Between reads the position is
# interpolated locally, so faster buys nothing.
POLL_MS=1000

# Redraw rate. The seconds tick and the title scrolls at this cadence.
FRAME_MS=200

# Silence for this long hands the display back to the Bar's own UI.
IDLE_MS=60000

REQUEST_TIMEOUT_MS=10000

# --- Cover art ---------------------------------------------------------------
# Stretch the cover's histogram before dithering. Sixteen greys is few enough
# that a dark cover otherwise lands on four of them. Set to 0 to see the
# untouched brightness instead.
ART_CONTRAST=1
